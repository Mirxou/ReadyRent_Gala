generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── تجار (Merchants) ────────────────────────────────────────────────
model Merchant {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime @default(now())
  items     Item[]
}

// ─── مستأجرون (Customers) ────────────────────────────────────────────
model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  createdAt DateTime  @default(now())
  bookings  Booking[]
  reviews   Review[]
}

// ─── معدات الإيجار (Rental Items) ───────────────────────────────────
model Item {
  id           String    @id @default(cuid())
  name         String
  description  String
  category     String
  imageUrl     String?
  dailyRate    Float
  deposit      Float     @default(0)
  insuranceFee Float     @default(0)
  available    Boolean   @default(true)
  merchantId   String
  merchant     Merchant  @relation(fields: [merchantId], references: [id])
  bookings     Booking[]
  reviews      Review[]
  createdAt    DateTime  @default(now())
}

// ─── الحجوزات + الضمان (Bookings + Escrow) ──────────────────────────
// status: PENDING_PAYMENT | CONFIRMED | OVERDUE | COMPLETED | CANCELLED
model Booking {
  id              String     @id @default(cuid())
  itemId          String
  item            Item       @relation(fields: [itemId], references: [id])
  customerId      String
  customer        Customer   @relation(fields: [customerId], references: [id])
  startDate       DateTime
  endDate         DateTime
  days            Int
  rentalPrice     Float
  deposit         Float
  insuranceFee    Float
  totalPrice      Float
  lateFeePerDay   Float
  lateFee         Float      @default(0)
  depositHeld     Float      @default(0)
  depositReturned Float      @default(0)
  status          String     @default("PENDING_PAYMENT")
  paymentRef      String?
  paidAt          DateTime?
  returnedAt      DateTime?
  lateWarningSent Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  review          Review?
  emails          EmailLog[]
}

// ─── التقييمات (Reviews — gated on COMPLETED bookings) ──────────────
model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

// ─── صندوق الصادر للبريد (Email outbox — simulated sendEmail) ───────
model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  toName    String
  subject   String
  body      String
  type      String
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  sentAt    DateTime @default(now())
}
